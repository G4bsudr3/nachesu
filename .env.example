# Template de variáveis do frontend (Vite). Copie para `.env` e preencha.
# APENAS chaves PUBLICÁVEIS entram aqui — nunca a service_role nem segredos server-side.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ── Secrets de backend (NÃO vão no .env do frontend) ─────────────────────────
# Configure via `supabase secrets set ...` no projeto. Referência:
#   SUPABASE_SERVICE_ROLE_KEY   (já provido pelo runtime das edge functions)
#   LOVABLE_API_KEY             (gateway de IA / e-mail / webhooks)
#   GEMINI_API_KEY              (embeddings do chora-bot)
#   GIPHY_API_KEY               (busca de GIFs no hub)
#   ALLOWED_ORIGINS             (SEC-10) ex.: "https://nachesu.lovable.app"
#   SAFETY_NOTIFY_SECRET        (SEC-08) segredo do endpoint interno de safety
